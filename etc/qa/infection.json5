{
    "timeout": 1800,
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "../../var/infection.log",
        "summary": "../../var/infection-summary.log",
        "json": "../../var/infection.json",
        "perMutator": "../../var/infection-per-mutator.md",
        "github": true
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "ignoreMsiWithNoMutations": true,
    "mutators": {
        "@default": true,
        "Division": {
            "ignore": [
                "ReactParallel\\Pool\\Infinite\\Infinite::run::84"
            ]
        },
        "Foreach_": {
            "ignore": [
                "ReactParallel\\Pool\\Infinite\\Infinite::close::106"
            ]
        },
        "GreaterThanOrEqualTo": {
            "ignore": [
                "ReactParallel\\Pool\\Infinite\\Infinite::run::89"
            ]
        },
        "IfNegation": {
            "ignore": [
                "ReactParallel\\Pool\\Infinite\\Group::create::25",
                "ReactParallel\\Pool\\Infinite\\Infinite"
            ]
        },
        "InstanceOf_": {
            "ignore": [
                "ReactParallel\\Pool\\Infinite\\Infinite"
            ]
        },
        "MethodCallRemoval": {
            "ignore": [
                "ReactParallel\\Pool\\Infinite\\Infinite"
            ]
        }
    }
}
